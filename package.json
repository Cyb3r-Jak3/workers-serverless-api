{
    "name": "serverless-api",
    "version": "2.5.0",
    "description": "Serverless version of my API",
    "scripts": {
        "dev": "wrangler dev --test-scheduled",
        "dev:remote": "wrangler dev --remote",
        "format": "prettier --write *.{json,js,ts} src/**/*.{js,ts} ",
        "test:lint": "eslint --max-warnings=0 src && prettier --check *.{json,js,ts} src/**/*.{js,ts}",
        "test:unit": "vitest run",
        "cf-typegen": "wrangler types",
        "test": "pnpm run test:lint && pnpm run test:unit"
    },
    "author": "cyb3r-jak3",
    "license": "MIT",
    "eslintConfig": {
        "root": true,
        "extends": [
            "typescript",
            "prettier"
        ]
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.18.7",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.0",
        "@openpgp/web-stream-tools": "^0.3.1",
        "@types/node": "^26.1.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-config-typescript": "^3.0.0",
        "globals": "^17.7.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "vitest": "~4.1.10",
        "wrangler": "4.114.0"
    },
    "dependencies": {
        "@cloudflare/workers-types": "^5.20260723.1",
        "@cyb3r-jak3/workers-common": "^5.6.2",
        "@octokit/core": "^7.0.6",
        "domhandler": "^6.0.1",
        "hono": "^4.12.31",
        "htmlparser2": "^12.0.0",
        "openpgp": "^6.3.1"
    }
}
